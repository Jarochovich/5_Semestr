{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Error",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  // Разрешённые хосты
  "AllowedHosts": "*",
  // Максимальное время ожидания сообщений (сек)
  "WaitEnqueue": 5

}
